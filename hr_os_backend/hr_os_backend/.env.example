# MongoDB is the application database. Local is deliberately the safe default.
MONGO_PROFILE=local

# Developer MongoDB (MongoDB Compass connection named "spiderman")
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
MONGO_LOCAL_DB=hr_onboarding

# Company integration MongoDB. Keep the real URI only in .env / deployment
# secrets; never commit credentials. This value is ignored in local mode.
MONGO_REMOTE_URI=mongodb://username:password@company-host:27017/?authSource=hr_onboarding
MONGO_REMOTE_DB=hr_onboarding

# Shared client/pool tuning
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=60000

# Required single-tenant company entity identifier
DEFAULT_ENTITY_ID=Zipaworld

# The legacy SQL layer is disabled while routes are migrated to MongoDB.
HRMS_DISABLE_DATABASE=true

# Application settings (replace these examples locally)
DEV_AUTH_BYPASS=true
DEV_ADMIN_EMAIL=admin@example.com
JWT_SECRET=replace-with-a-long-random-secret
